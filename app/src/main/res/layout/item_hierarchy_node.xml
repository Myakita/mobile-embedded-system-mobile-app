<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/appSurface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/layoutNodeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <!-- Индикатор раскрытия (▾ / ▸) -->
        <TextView
            android:id="@+id/textNodeExpandIcon"
            style="@style/Text.Label"
            android:layout_width="20dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="▾"
            android:textColor="?attr/appInk"
            android:textSize="14sp" />

        <!-- Бэдж типа узла (БН / РОТА / ВЗВОД / ОТД / БОЕЦ) -->
        <TextView
            android:id="@+id/textNodeTypeBadge"
            style="@style/Text.Label"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_marginStart="4dp"
            android:background="?attr/appInk"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="ОТД"
            android:textColor="?attr/appSurface"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Название узла -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textNodeTitle"
                style="@style/Text.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1-е Отделение"
                android:textColor="?attr/appInk"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textNodeTopicPreview"
                style="@style/Text.Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="mesh-a/BN1/CO2/PL3/SQ1/#"
                android:textColor="?attr/appInk2"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Сводка статуса онлайн/всего -->
        <TextView
            android:id="@+id/textNodeSummaryBadge"
            style="@style/Text.Value"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:background="?attr/appBg"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="3/3 • OK"
            android:textColor="?attr/appStatusOk"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/appHairline" />
</LinearLayout>
